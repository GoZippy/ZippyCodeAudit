{
  "name": "zippycodesaudit",
  "version": "1.0.0",
  "description": "Comprehensive code auditing toolkit for vibe coders",
  "main": "electron-main.js",
  "bin": {
    "zippy-audit": "src/cli/index.js",
    "zca": "src/cli/index.js"
  },
  "scripts": {
    "start": "node src/cli/index.js",
    "dev": "nodemon src/cli/index.js",
    "electron": "npm run build:dashboard:static && electron .",
    "electron:dev": "npm run build:dashboard:static && NODE_ENV=development electron .",
    "build": "npm run build:cli && npm run build:dashboard && npm run build:vscode",
    "build:cli": "echo 'CLI tool ready for distribution'",
    "build:dashboard": "npm run build:dashboard:static",
    "build:dashboard:static": "node scripts/build-dashboard.js",
    "build:vscode": "cd extensions/vscode && npm run compile",
    "build:electron": "npm run build:dashboard:static && electron-builder",
    "build:electron:win": "npm run build:dashboard:static && electron-builder --win --x64",
    "build:electron:mac": "npm run build:dashboard:static && electron-builder --mac",
    "build:electron:linux": "npm run build:dashboard:static && electron-builder --linux",
    "build:electron:all": "npm run build:dashboard:static && electron-builder --win --mac --linux",
    "serve:dashboard": "node scripts/serve-dashboard.js",
    "dev:dashboard": "npm run build:dashboard:static && npm run serve:dashboard",
    "dev:vscode": "cd extensions/vscode && npm run watch",
    "package:vscode": "cd extensions/vscode && npm run vscode:prepublish",
    "test": "jest",
    "lint": "eslint src/",
    "format": "prettier --write src/",
    "prepublishOnly": "npm run test && npm run lint"
  },
  "keywords": [
    "code-audit",
    "static-analysis",
    "quality-assurance",
    "developer-tools",
    "productivity",
    "ai-powered",
    "zippy",
    "vibe-coding"
  ],
  "author": "ZippyCodeAudit Team",
  "license": "MIT",
  "engines": {
    "node": ">=16.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/GoZippy/ZippyCodeAudit.git"
  },
  "bugs": {
    "url": "https://github.com/GoZippy/ZippyCodeAudit/issues"
  },
  "homepage": "https://github.com/GoZippy/ZippyCodeAudit#readme",
  "dependencies": {
    "axios": "^1.6.0",
    "boxen": "^5.1.0",
    "chalk": "^4.1.2",
    "commander": "^8.3.0",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "fs-extra": "^11.2.0",
    "glob": "^8.1.0",
    "helmet": "^8.1.0",
    "inquirer": "^8.2.6",
    "js-yaml": "^4.1.0",
    "jsonwebtoken": "^9.0.2",
    "lodash": "^4.17.0",
    "marked": "^9.0.0",
    "morgan": "^1.10.1",
    "ora": "^5.4.1",
    "simple-git": "^3.20.0",
    "table": "^6.8.0"
  },
  "devDependencies": {
    "clean-css": "^5.3.3",
    "electron": "^27.3.11",
    "electron-builder": "^24.13.3",
    "eslint": "^8.50.0",
    "html-minifier-terser": "^7.2.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.0",
    "prettier": "^3.0.0",
    "serve": "^14.2.5"
  },
  "build": {
    "appId": "com.zippyfoundation.codeaudit",
    "productName": "ZippyCodeAudit",
    "copyright": "Copyright © 2025 ZippyFoundation",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "dist/**/*",
      "src/**/*",
      "node_modules/**/*",
      "electron-main.js",
      "electron-preload.js",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "src/dashboard/public/favicon.svg",
      "publisherName": "ZippyFoundation"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "src/dashboard/public/favicon.svg",
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "src/dashboard/public/favicon.svg",
      "category": "Development"
    }
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/**/*.test.js"
    ]
  },
  "eslintConfig": {
    "env": {
      "browser": true,
      "node": true,
      "es2022": true,
      "serviceworker": true
    },
    "extends": [
      "eslint:recommended"
    ],
    "rules": {
      "no-console": "off",
      "no-unused-vars": "warn"
    }
  },
  "prettier": {
    "semi": true,
    "trailingComma": "es5",
    "singleQuote": true,
    "printWidth": 100,
    "tabWidth": 2
  }
}
